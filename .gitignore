# G:\Dx is a hub repository. Child folders are independent repositories,
# archives, runtime state, or pinned tools and must not be absorbed here.
/*

!/LOG.md
!/.gitattributes
!/.gitignore
!/.rgignore
!/.github/
!/.github/workflows/
!/.dx/
!/AGENTS.md
!/CHANGELOG.md
!/HELP.md
!/DEPRECATED_README.md
!/COLAB.md
!/CURRENT_STATUS.md
!/DX.md
!/DX_TOOLS_AI_GAP.md
!/DX_LANE_PASS_SYSTEM.md
!/MINICPM5-200MB-PLAN.md
!/DX_MANAGER_MEMORY.md
!/PLAN.md
!/README.md
!/TODO.md
!/docs/
!/docs/policies/
!/docs/superpowers/
!/docs/superpowers/plans/
!/dx
!/scripts/
!/templates/
!/templates/dx-starter/
!/templates/dx-starter/*
!/templates/dx-starter/.dx/
!/templates/dx-starter/.dx/*
!/build.ps1
!/tokens
!/tpu/
!/tpu/*
!/tpu/*/
# kernels and their generated notebooks -- no weights, no tokens
!/tpu/*/kernel.py
!/tpu/*/*/
!/tpu/*/*/kernel.py
!/tpu/*/*/make_notebook.py
!/tpu/*/*/kernel-metadata.json
!/tpu/*/*/notebook.ipynb
!/tpu/*/*/receipt-*.json
!/tpu/*/make_notebook.py
!/tpu/*/kernel-metadata.json
!/tpu/*/notebook.ipynb
!/tpu/*/receipt-*.json
!/tpu/pq2-decode/
!/tpu/pq2-decode/tq2_decode.py
!/tpu/*/*.md
!/tpu/*/*/*.md
# env.ps1 inside tpu/ is a live Kaggle API token copied for convenience. Never commit it.
/tpu/env.ps1
!/backup.json
!/keys.dx
!/descriptions.dx
!/tools.dx
!/tools.json
# PROMPTS.md is a working notes file that has accumulated live credentials.
# Ignored deliberately: it must never be pushed again.
/PROMPTS.md
!/README.md

/.dx/*
!/.dx/launch-workspace.toml
trash/
**/target/
**/node_modules/
**/.next/
**/dist/
**/build/
**/.tmp/
**/*.pdb
**/*.exe
**/*.dll
# local syntax checks leave these next to tpu kernels; they are bytecode, never sources
**/__pycache__/

# typesafe is its own repo (essence-dx/dx-typesafe) - do not track it here.
/typesafe/

# codebase/ is its own repo (essence-dx/codebase) - do not track it here.
# The root /* rule above already covers it; this line states the intent.

!/JULES_BUILD_PROMPT.md
!/CAP.md
!/DX_HARNESS.md
